# ============================================================
# KroviaNextGen — variables de entorno
# Copia estos nombres en Vercel → Settings → Environment Variables.
# Para probar en local con `vercel dev`, duplica este archivo como
# .env.local y rellénalo. NUNCA subas .env.local al repositorio.
# ============================================================

# --- Supabase (obligatorio) ---------------------------------
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Settings → API → service_role. SECRETA: se salta el RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Correo, Resend (sin esto se reserva pero no avisa) -----
RESEND_API_KEY=
MAIL_FROM=KroviaNextGen <hola@tudominio.com>
MAIL_ADMIN=tu@correo.com

# --- Agenda (opcional: estos son los valores por defecto) ---
AGENDA_TZ=Europe/Madrid
AGENDA_HORARIO=08:00-15:00
AGENDA_DIAS=1,2,3,4,5
AGENDA_DURACION=15
AGENDA_PASO=30
AGENDA_ANTELACION_H=2
AGENDA_DIAS_VISTA=10
MARCA=KroviaNextGen
# Tu dominio. Sin esto el correo NO lleva enlace de cancelación.
SITIO_URL=

# --- Recordatorio automático (Cron de Vercel) ---------------
# Vercel manda "Authorization: Bearer $CRON_SECRET" a /api/cron.
# Sin secreto el endpoint queda abierto: ponlo.
CRON_SECRET=
# Cuántos días antes avisa (1 = el día anterior).
RECORDATORIO_DIAS=1

# --- WhatsApp, Meta Cloud API (opcional) --------------------
# Sin plantilla aprobada solo se puede escribir dentro de la
# ventana de 24 h. Ver el Paso 8 del README.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_ADMIN=34600112233
WHATSAPP_TEMPLATE_CLIENTE=
WHATSAPP_TEMPLATE_ADMIN=
# Si la dejas vacía, el recordatorio usa la plantilla del cliente.
WHATSAPP_TEMPLATE_RECORDATORIO=
WHATSAPP_TEMPLATE_LANG=es
